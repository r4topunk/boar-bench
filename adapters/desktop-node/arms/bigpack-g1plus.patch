diff --git a/src/rag/retrieve.g1plus.test.ts b/src/rag/retrieve.g1plus.test.ts
new file mode 100644
index 00000000..99fa59bd
--- /dev/null
+++ b/src/rag/retrieve.g1plus.test.ts
@@ -0,0 +1,76 @@
+import { describe, it, expect, vi } from "vitest";
+
+vi.mock("./db", () => ({ getDb: async () => ({ getAllAsync: async () => [] }) }));
+vi.mock("./embed", () => ({ embeddingEngine: { embed: async () => new Float32Array([1, 0, 0, 0]) } }));
+vi.mock("./ptLexiconAsset", () => ({ ptLexicon: () => ({}) }));
+// Sonar G1+ (bigpack-relevance-gate): large-pack keyword hits (no cosine gate, max-normalized BM25 ~1.0) vs candidates
+// that passed a relevance check: a format-1 chunk at cos >= 0.70, or a keyword hit whose article lead is >= 0.70.
+vi.mock("./packs", () => {
+  const TEXTS: Record<number, string> = {
+    1: "The redback spider is a venomous spider native to Australia.",
+    2: "BitTorrent is a peer-to-peer file sharing protocol.",
+    3: "PeerDAS lets nodes sample blob data from their peers.",
+    4: "The Nobel Prize in Literature is awarded annually by the Swedish Academy.",
+    5: "Alfred Nobel's will of 1895 established the prizes, first given in 1901.",
+    6: "Laureates receive a gold medal, a diploma and a sum of money in Stockholm.",
+    7: "Berlin is the capital of Germany and its largest city.",
+    8: "Paris is the capital of France, on the Seine.",
+    9: "Germany's capital moved from Bonn to Berlin after reunification.",
+  };
+  const hit = (articleId: number, chunkId: number, title: string, via: "title" | "bm25", score: number, leadSim?: number, source = "enwiki") => ({
+    articleId, chunkId, title, section: "", text: TEXTS[chunkId], start: 0, end: 1, score, via, source, views: 0, lead: true, action: false,
+    ...(leadSim !== undefined ? { leadSim } : {}),
+  });
+  // The real packHitToChunk carries leadSim as leadSimilarity (packs.ts); the mock does the same.
+  const packHitToChunk = (packId: string, h: any) => ({
+    chunkId: `pack:${packId}:${h.chunkId}`, docId: `pack:${packId}:a${h.articleId}`, title: h.title, body: h.text, score: h.score,
+    matchType: "lexical", ...(h.leadSim !== undefined ? { leadSimilarity: h.leadSim } : {}),
+  });
+  const v5 = (id: string, title: string, sim: number) => ({ chunkId: `v5:${id}`, docId: `v5:${title}`, title, body: `${title} body ${id}`, source: "Wikipedia", score: sim, similarity: sim, matchType: "semantic" as const });
+  return {
+    packHitToChunk,
+    searchWikiPacks: async (q: string) => {
+      if (/spider/.test(q))
+        // Keyword noise with the top BM25 and no lead vector; a crypto hit promoted by its lead cosine (0.76).
+        return [
+          { packId: "en", hits: [hit(1, 1, "Redback spider", "bm25", 9), hit(2, 2, "BitTorrent", "bm25", 8)] },
+          { packId: "crypto", hits: [hit(3, 3, "PeerDAS", "bm25", 2, 0.761, "ethspecs")] },
+        ];
+      if (/Nobel/.test(q)) return [{ packId: "en", hits: [4, 5, 6].map((i) => hit(1, i, "Nobel Prize in Literature", "title", 1)) }];
+      if (/compare/i.test(q))
+        return [{ packId: "en", hits: [hit(7, 7, "Berlin", "title", 1), hit(7, 9, "Berlin", "title", 1), hit(8, 8, "Paris", "title", 1), hit(8, 6, "Paris", "title", 1)] }];
+      // Only unverified keyword hits (one below the lead bar): nothing is removed, they still fill the slots.
+      return [{ packId: "en", hits: [hit(1, 1, "Redback spider", "bm25", 9, 0.69), hit(2, 2, "BitTorrent", "bm25", 8)] }];
+    },
+    searchPacks: async (q: string) => ({
+      lexical: [],
+      semantic: /spider/.test(q)
+        ? [v5("snake", "Snakebite", 0.72)]
+        : /Nobel/.test(q)
+          ? [v5("ki", "Kazuo Ishiguro", 0.8)]
+          : [],
+    }),
+  };
+});
+
+import { retrieve } from "./retrieve";
+
+describe("retrieve: Sonar G1+ verified-first ordering", () => {
+  it("verified candidates (cos-gated chunk, keyword hit with lead cos >= 0.70) go before ungated keyword hits", async () => {
+    const out = await retrieve("What should I do after a spider bite?", 3);
+    expect(out.map((c) => c.title)).toEqual(["Snakebite", "PeerDAS", "Redback spider"]);
+    expect(out[1].leadSimilarity).toBeCloseTo(0.761);
+  });
+  it("named passages first, at most 2 per article; the freed slot goes to the verified candidate", async () => {
+    const out = await retrieve("Who received the Nobel Prize in Literature in 2017?", 3);
+    expect(out.map((c) => c.title)).toEqual(["Nobel Prize in Literature", "Nobel Prize in Literature", "Kazuo Ishiguro"]);
+  });
+  it("several named articles keep 2 passages each, past top-K (both sides of a comparison)", async () => {
+    const out = await retrieve("Compare Berlin and Paris", 3);
+    expect(out.map((c) => c.chunkId)).toEqual(["pack:en:7", "pack:en:9", "pack:en:8", "pack:en:6"]);
+  });
+  it("removes nothing: with no verified candidate, keyword hits (lead cos 0.69 included) still fill the slots", async () => {
+    const out = await retrieve("Tell me about venom", 3);
+    expect(out.map((c) => c.title)).toEqual(["Redback spider", "BitTorrent"]);
+  });
+});
