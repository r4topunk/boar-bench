diff --git a/src/inference/memoryFit.test.ts b/src/inference/memoryFit.test.ts
index 882856bf..315c2292 100644
--- a/src/inference/memoryFit.test.ts
+++ b/src/inference/memoryFit.test.ts
@@ -162,3 +162,84 @@ describe("availableRamFrom", () => {
     expect(availableRamFrom({ totalBytes: 12 * GiB, rssBytes: GiB, availBytes: 10 * GiB })).toBe(10 * GiB);
   });
 });
+
+// Anvil fit-estimate-repack: the CPU backend repacks Q4_K/Q4_0/Q6_K/Q8_0… weights into anonymous memory, and while
+// loading the file pages and the repacked copy are both resident. Frozen expectations T1–T6 (card), real header shapes.
+describe("estimateMemoryFit: repacked weights and the load peak (fit-estimate-repack)", () => {
+  const QWEN3_4B = {
+    "general.architecture": "qwen3",
+    "general.file_type": "15",
+    "qwen3.block_count": "36",
+    "qwen3.embedding_length": "2560",
+    "qwen3.attention.head_count": "32",
+    "qwen3.attention.head_count_kv": "8",
+    "qwen3.attention.key_length": "128",
+    "qwen3.attention.value_length": "128",
+    "qwen3.feed_forward_length": "9728",
+    "qwen3.vocab_size": "151936",
+  };
+  const QWEN25_15B = { ...QWEN25_1_5B, "qwen2.attention.key_length": "128", "qwen2.vocab_size": "151936" };
+  const Q4_K_M = 15;
+  const fourB = (totalRamBytes: number, repack: boolean, availBytes = 0) =>
+    estimateMemoryFit({
+      fileBytes: 2.5e9, nCtx: 4096, shape: parseGgufShape(QWEN3_4B), totalRamBytes,
+      availableRamBytes: availableRamFrom({ totalBytes: totalRamBytes, rssBytes: 0, availBytes }), repack, fileType: Q4_K_M,
+    });
+
+  it("T1: the 4B Q4_K_M on the moto g75 (7.2 GiB, budget 4.7 GiB) fits only without repack", () => {
+    const f = fourB(7.2 * GiB, true);
+    expect(f.availableBytes).toBeCloseTo(4.7 * GiB, -6);
+    expect(f.verdict).toBe("repack-peak");
+    expect(f.loadPeakBytes).toBeGreaterThan(4.7 * GiB);
+    expect(f.repackBytes / 2.5e9).toBeCloseTo(0.97, 2);
+  });
+
+  it("T2: the same load without repack is resident with ~1 GiB of anonymous memory (Probe A: 0.88–0.91 GB)", () => {
+    const f = fourB(7.2 * GiB, false);
+    expect(f.verdict).toBe("resident");
+    expect(f.repackBytes).toBe(0);
+    expect(f.anonBytes).toBeLessThan(1.2 * GiB);
+    expect(f.loadPeakBytes).toBe(f.anonBytes);
+  });
+
+  it("T3: on a 12 GB phone (11.6 GiB, budget 8.7 GiB) the repack peak fits: resident", () => {
+    const f = fourB(11.6 * GiB, true);
+    expect(f.availableBytes).toBeCloseTo(8.7 * GiB, -6);
+    expect(f.verdict).toBe("resident");
+    expect(f.loadPeakBytes).toBeLessThan(8.7 * GiB);
+  });
+
+  it("T4: the 1.5B Q4_K_M on the g75 is resident with repack (peak ~2.4 GiB; the g75 measured RSS 2.6 GB, no kill)", () => {
+    const f = estimateMemoryFit({
+      fileBytes: 0.99e9, nCtx: 4096, shape: parseGgufShape(QWEN25_15B), totalRamBytes: 7.2 * GiB,
+      availableRamBytes: availableRamFrom({ totalBytes: 7.2 * GiB, rssBytes: 0 }), repack: true, fileType: Q4_K_M,
+    });
+    expect(f.verdict).toBe("resident");
+    expect(f.repackBytes).toBeGreaterThan(0);
+    expect(f.loadPeakBytes).toBeLessThan(2.6 * GiB);
+  });
+
+  it("T5: a ternary (TQ2_0, Maple-like) or unknown file type is never repacked: verdicts as today", () => {
+    const base = { fileBytes: 11 * GiB, nCtx: 4096, shape: parseGgufShape(QWEN3_30B_A3B), totalRamBytes: 12 * GiB, availableRamBytes: 7 * GiB };
+    const today = estimateMemoryFit(base);
+    for (const fileType of [37, undefined, 1024]) {
+      const f = estimateMemoryFit({ ...base, repack: true, ...(fileType !== undefined ? { fileType } : {}) });
+      expect(f.repackBytes).toBe(0);
+      expect(f.verdict).toBe(today.verdict);
+      expect(f.anonBytes).toBe(today.anonBytes);
+    }
+  });
+
+  it("T6: the 4B on the iPhone 13 (4 GB) is still too big, as before: not resident, not repack-peak", () => {
+    const f = fourB(4 * GiB, true);
+    expect(f.verdict).not.toBe("resident");
+    expect(f.verdict).not.toBe("repack-peak");
+    expect(f.verdict).toBe(fourB(4 * GiB, false).verdict);
+  });
+
+  it("describeFit explains a repack-peak load without asking the user to free RAM", () => {
+    const msg = describeFit("qwen3-4b.gguf", fourB(7.2 * GiB, true))!;
+    expect(msg).toMatch(/without weight repacking/);
+    expect(msg).not.toMatch(/[Cc]lose other apps/);
+  });
+});
