+import { describe, it, expect } from "vitest";
+import { UNCONFIRMED_SHOWN, unconfirmedAnswer, unconfirmedLabel } from "./unconfirmed";
+
+describe("unconfirmedAnswer (Decision 1, arm A)", () => {
+  it("EN: label, draft, then the source's own sentence cited as [n]", () => {
+    expect(unconfirmedAnswer("  Kyoto was the capital.  ", false, { text: "Kyoto was the imperial capital for a thousand years.", sourceNumber: 2, lead: null })).toBe(
+      "Not confirmed by the sources: the passages found don't back this answer. Check it before relying on it.\n\nKyoto was the capital.\n\nFrom the source [2]: “Kyoto was the imperial capital for a thousand years.”"
+    );
+  });
+  it("PT with an English passage: the language lead, with the [n]", () => {
+    expect(unconfirmedAnswer("Quioto foi a capital.", true, { text: "Kyoto was the imperial capital.", sourceNumber: 1, lead: "Da fonte offline (em inglês):" })).toBe(
+      "Não confirmado pelas fontes: os trechos encontrados não sustentam esta resposta. Confira antes de confiar nela.\n\nQuioto foi a capital.\n\nDa fonte offline (em inglês) [1]: “Kyoto was the imperial capital.”"
+    );
+  });
+  it("PT without a lead, and no snippet at all", () => {
+    expect(unconfirmedAnswer("A.", true, { text: "B.", sourceNumber: 3, lead: null })).toMatch(/\n\nDa fonte \[3\]: “B\.”$/);
+    expect(unconfirmedAnswer("Draft.", false, null)).toBe(`${unconfirmedLabel(false)}\n\nDraft.`);
+    expect(unconfirmedAnswer("Draft.", false, { text: "  ", sourceNumber: 1, lead: null })).toBe(`${unconfirmedLabel(false)}\n\nDraft.`);
+  });
+  it("the reason code", () => {
+    expect(UNCONFIRMED_SHOWN).toBe("grounding:unconfirmed-shown");
+  });
+});
diff --git a/src/routing/unconfirmed.ts b/src/routing/unconfirmed.ts
new file mode 100644
index 00000000..2fdb52c8
--- /dev/null
+++ b/src/routing/unconfirmed.ts
@@ -0,0 +1,40 @@
+/**
+ * Decision 1, arm A (Kiln-2, 2026-10-01): the compact model's answer that the citation check could not confirm
+ * (every [n] removed, or no [n] at all with sources in its prompt) is no longer erased after it streamed. It stays,
+ * under a "not confirmed by the sources" label, followed by a verbatim sentence of the best source (the instant
+ * snippet the engine already extracts), cited as that source's [n]. Health/danger questions and the known-false and
+ * risky-instruction patterns keep their strict path (answer.ts). Pure.
+ */
+
+/** Reason code: a compact answer the citation check would have declined is shown, labelled. */
+export const UNCONFIRMED_SHOWN = "grounding:unconfirmed-shown";
+
+/** Which check would have declined it (a second reason code, for the eval). */
+export type UnconfirmedFrom = "all-citations-removed" | "uncited-with-sources";
+
+export function unconfirmedLabel(pt: boolean): string {
+  return pt
+    ? "Não confirmado pelas fontes: os trechos encontrados não sustentam esta resposta. Confira antes de confiar nela."
+    : "Not confirmed by the sources: the passages found don't back this answer. Check it before relying on it.";
+}
+
+export interface VerifiedSnippet {
+  /** A source's own sentence(s), verbatim. */
+  text: string;
+  /** 1-based number of that source in the answer's sources. */
+  sourceNumber: number;
+  /** sourceLanguageLead(): "Da fonte offline (em inglês):" for an English passage under a PT question, else null. */
+  lead: string | null;
+}
+
+/** The label, the draft as the model wrote it (citations already removed), then the verified snippet when there is one. */
+export function unconfirmedAnswer(draft: string, pt: boolean, snippet: VerifiedSnippet | null): string {
+  const parts = [unconfirmedLabel(pt), draft.trim()];
+  if (snippet && snippet.text.trim()) {
+    const head = snippet.lead
+      ? `${snippet.lead.replace(/:\s*$/, "")} [${snippet.sourceNumber}]:`
+      : `${pt ? "Da fonte" : "From the source"} [${snippet.sourceNumber}]:`;
+    parts.push(`${head} “${snippet.text.trim()}”`);
+  }
+  return parts.join("\n\n");
+}
