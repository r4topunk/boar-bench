+describe("classifyTask situation shape (Compass situation-shape-route, QUEUE #13)", () => {
+  it("a personal situation asking what to do is a lookup, EN and PT", () => {
+    for (const q of [
+      "My friend collapsed in the heat and is confused. What should I do?",
+      "I got stung on the beach and my arm is swelling, what do I do",
+      "The power went out and the stove smells of gas, what now",
+      "A wasp stung my son and his lips are puffy, how do I help him",
+      "Meu filho engoliu uma pilha, o que eu faço?",
+      "Minha mãe desmaiou na cozinha e não acorda, e agora",
+      "Caiu água sanitária no meu olho, como eu tiro isso",
+    ])
+      expect(classifyTask(q), q).toBe("lookup");
+  });
+  it("only rewrites chat: other types and greetings are unchanged", () => {
+    expect(classifyTask("hi")).toBe("greeting");
+    expect(classifyTask("tell me a joke")).toBe("conversation");
+    expect(classifyTask("Good morning!")).toBe("greeting");
+    expect(classifyTask("Why should I drink water after a run?")).toBe("research");
+    expect(classifyTask("Write a short poem about the sea")).toBe("chat");
+    expect(classifyTask("Obrigado pela ajuda")).toBe("chat");
+  });
+  it("Unicode word boundaries, as in the frozen Python regex", () => {
+    expect(SITUATION_SHAPE.test("Uma devoção antiga ao mar")).toBe(false);
+    expect(SITUATION_SHAPE.test("my shoulder hurts after the gym")).toBe(false);
+    expect(SITUATION_SHAPE.test("Devo ligar para alguém agora")).toBe(true);
+    expect(classifyTask("Uma devoção antiga ao mar, me conte")).toBe("chat");
+  });
+});
