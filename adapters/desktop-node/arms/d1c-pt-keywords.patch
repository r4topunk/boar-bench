@@ -0,0 +1,65 @@
+import { describe, it, expect } from "vitest";
+import type { RetrievedChunk } from "../rag/retrieve.types";
+import { attributeCitations, checkCitations, citationSupport, ptKeyUnits } from "./citations";
+import { ptLexicon } from "../rag/ptLexiconAsset";
+
+// Decision 1, arm C: PT answers compared with English sources through the PT->EN lexicon.
+const chunk = (chunkId: string, title: string, body: string): RetrievedChunk => ({ chunkId, docId: chunkId, title, body, score: 1, matchType: "hybrid" });
+const LEX = {
+  "prova de participação": "Proof of stake",
+  "prova de participacao": "Proof of stake",
+  "mineração": "Mining",
+  "mineracao": "Mining",
+  "energia": "Energy",
+  "capital": "Capital city",
+  "japão": "Japan",
+  "japao": "Japan",
+};
+const POS = chunk("p", "Proof of stake", "Proof of stake replaces mining: validators lock ether instead of spending energy.");
+
+describe("ptKeyUnits", () => {
+  it("longest lexicon run first; function words are not key units", () => {
+    expect(ptKeyUnits("A prova de participação substitui a mineração e foi adotada [1].", LEX)).toEqual([
+      { own: ["prova", "participacao"], english: ["proof", "stak"] },
+      { own: ["substitui"], english: null },
+      { own: ["mineracao"], english: ["min"] },
+      { own: ["adotada"], english: null },
+    ]);
+  });
+  it("plural via singularsPt; a qualifier-free English title; numbers and English words stay as they are", () => {
+    expect(ptKeyUnits("Energias do Ethereum em 2022", LEX)).toEqual([
+      { own: ["energia"], english: ["energy"] },
+      { own: ["ethereum"], english: null },
+      { own: ["2022"], english: null },
+    ]);
+  });
+});
+
+describe("checkCitations / attributeCitations with the lexicon (PT question)", () => {
+  const pt = "A prova de participação substitui a mineração e economiza energia [1].";
+  it("a faithful PT paraphrase keeps its [n] with the lexicon, loses it without (today's behaviour)", () => {
+    expect(checkCitations(pt, [POS]).removed).toEqual([1]);
+    expect(checkCitations(pt, [POS], LEX)).toEqual({ text: pt, removed: [] });
+    expect(citationSupport(pt, POS, LEX)).toBe(0.6); // prova de participação, mineração, energia of 5 units
+  });
+  it("a wrong PT claim still loses it: the lexicon only translates, the bar is unchanged", () => {
+    const wrong = "O Japão adotou a mineração como capital oficial em 1990 [1].";
+    expect(checkCitations(wrong, [POS], LEX).removed).toEqual([1]);
+  });
+  it("attribution: a supported PT sentence without [n] gets one with the lexicon only", () => {
+    // 3 of 4 units (usam is not in the source): 0.75, the attribution bar.
+    const s = "A prova de participação e a mineração usam energia.";
+    expect(attributeCitations(s, [POS]).added).toEqual([]);
+    expect(attributeCitations(s, [POS], LEX)).toEqual({ text: "A prova de participação e a mineração usam energia [1].", added: [1] });
+  });
+  it("English is untouched: no lexicon, identical results", () => {
+    const en = "Proof of stake replaces mining [1]. The Moon is made of cheese [1].";
+    expect(checkCitations(en, [POS])).toEqual(checkCitations(en, [POS], undefined));
+    expect(checkCitations(en, [POS]).removed).toEqual([1]);
+  });
+  it("the bundled lexicon maps everyday words (asset loaded)", () => {
+    const lex = ptLexicon();
+    const units = ptKeyUnits("O efeito estufa é causado por gases que retêm calor na atmosfera.", lex);
+    expect(units.find((u) => u.own.join(" ") === "efeito estufa")?.english).toEqual(["greenhous", "effect"]); // terms(): stemmed
+  });
+});
