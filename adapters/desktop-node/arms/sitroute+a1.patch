@@ -0,0 +1,60 @@
+import { describe, it, expect, afterEach } from "vitest";
+import { DANGER_HEAD_V1, dangerProbability, isDangerQuestion, isDangerVector } from "./dangerDetector";
+import { clearQueryVectors, queryVectorFor, registerQueryEmbedder, rememberQueryVector } from "../rag/queryVector";
+
+const w = DANGER_HEAD_V1.w;
+const norm = Math.sqrt(w.reduce((s, x) => s + x * x, 0));
+/** The head's own direction scores sigmoid(|w| + b): danger. Its opposite: not danger. */
+const DANGER_VEC = Float32Array.from(w.map((x) => x / norm));
+const SAFE_VEC = Float32Array.from(w.map((x) => -x / norm));
+
+afterEach(() => {
+  registerQueryEmbedder(null);
+  clearQueryVectors();
+});
+
+describe("danger detector v1 (frozen head)", () => {
+  it("is the frozen head: 384 weights, bias, tau 0.5", () => {
+    expect(w).toHaveLength(384);
+    expect(DANGER_HEAD_V1.b).toBeCloseTo(-2.7524463243222175, 12);
+    expect(DANGER_HEAD_V1.tau).toBe(0.5);
+  });
+
+  it("p = sigmoid(w·x + b) on the L2-normalized vector", () => {
+    const p = dangerProbability(DANGER_VEC)!;
+    expect(p).toBeCloseTo(1 / (1 + Math.exp(-(norm + DANGER_HEAD_V1.b))), 9);
+    expect(p).toBeGreaterThan(0.5);
+    expect(dangerProbability(SAFE_VEC)!).toBeLessThan(0.5);
+    // Scale does not matter (the engine's vectors may or may not come normalized).
+    expect(dangerProbability(DANGER_VEC.map((x) => x * 7.5))!).toBeCloseTo(p, 9);
+    // The zero vector scores the bias alone: sigmoid(b) < 0.5 is never danger, but it is reported as unscorable.
+    expect(dangerProbability(new Float32Array(384))).toBeNull();
+  });
+
+  it("never flags a vector it can't score", () => {
+    expect(isDangerVector(undefined)).toBe(false);
+    expect(isDangerVector(new Float32Array(768))).toBe(false);
+    expect(isDangerVector(new Float32Array(384))).toBe(false);
+    expect(isDangerVector(Float32Array.from(DANGER_VEC, (x, i) => (i === 0 ? NaN : x)))).toBe(false);
+  });
+
+  it("reuses the vector retrieval remembered for the same text: no second embedding", async () => {
+    let calls = 0;
+    registerQueryEmbedder(async () => (calls++, SAFE_VEC));
+    rememberQueryVector("q", DANGER_VEC);
+    expect(await isDangerQuestion("q")).toBe(true);
+    expect(calls).toBe(0);
+    expect(await isDangerQuestion("other text")).toBe(false);
+    expect(calls).toBe(1);
+    await queryVectorFor("other text");
+    expect(calls).toBe(1);
+  });
+
+  it("no embedder, or an embedder that throws: not danger", async () => {
+    expect(await isDangerQuestion("q")).toBe(false);
+    registerQueryEmbedder(async () => {
+      throw new Error("model not loaded");
+    });
+    expect(await isDangerQuestion("q")).toBe(false);
+  });
+});
diff --git a/src/routing/dangerDetector.ts b/src/routing/dangerDetector.ts
new file mode 100644
index 00000000..83b5b70d
--- /dev/null
+++ b/src/routing/dangerDetector.ts
@@ -0,0 +1,42 @@
+/**
+ * Danger detector v1 (Compass, rnd/research/compass/cards/embedding-danger-detector-v1.md; FROZEN combined
+ * sha256 6f18dddf…2294): a logistic head over the question's bge-small-en-v1.5 embedding, the same vector
+ * retrieval computes (raw question, no prefix). danger = sigmoid(w·x + b) > 0.5 on the L2-normalized vector.
+ *
+ * dangerHead.v1.json is the frozen health-lr.v1.json byte for byte (sha256 f5d5d32f…c4dc768): 384 weights + bias.
+ * Used only as an addition to isHealthQuestion, and only where an answer would otherwise come from memory with
+ * no source (answer.ts): it never changes retrieval, the health path or which sources are shown.
+ */
+import head from "./dangerHead.v1.json";
+import { queryVectorFor } from "../rag/queryVector";
+
+export interface DangerHead {
+  w: number[];
+  b: number;
+  tau: number;
+}
+
+export const DANGER_HEAD_V1: DangerHead = { w: head.w, b: head.b, tau: head.tau };
+
+/** p(danger) for an embedding; null for a vector the head can't score (wrong size, zero, non-finite). */
+export function dangerProbability(vec: ArrayLike<number>, h: DangerHead = DANGER_HEAD_V1): number | null {
+  if (vec.length !== h.w.length) return null;
+  let norm = 0;
+  for (let i = 0; i < vec.length; i++) norm += vec[i] * vec[i];
+  norm = Math.sqrt(norm);
+  if (!(norm > 0) || !Number.isFinite(norm)) return null;
+  let z = h.b;
+  for (let i = 0; i < vec.length; i++) z += (h.w[i] * vec[i]) / norm;
+  return 1 / (1 + Math.exp(-z));
+}
+
+export function isDangerVector(vec: ArrayLike<number> | undefined, h: DangerHead = DANGER_HEAD_V1): boolean {
+  if (!vec) return false;
+  const p = dangerProbability(vec, h);
+  return p !== null && p > h.tau;
+}
+
+/** The detector on the raw question: retrieval's vector for the same text when there is one, else one embedding. */
+export async function isDangerQuestion(query: string): Promise<boolean> {
+  return isDangerVector(await queryVectorFor(query));
+}
