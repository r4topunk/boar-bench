+/**
+ * Query vectors retrieval already computed, kept so a classifier on the same text (the danger detector,
+ * src/routing/dangerDetector.ts) reuses them instead of embedding the question again.
+ *
+ * Pure on purpose: retrieve.ts registers the embedder and remembers every vector it computes; the
+ * answerer reads them here without importing the native embedding engine (its deps stay injectable).
+ * With no embedder registered (unit tests, a build without retrieval) queryVectorFor returns undefined.
+ */
+export type QueryEmbedder = (text: string) => Promise<Float32Array>;
+
+/** A few answers' worth: retrieve() embeds 1-2 texts per question (PT: the English names too). */
+const KEEP = 8;
+let embedder: QueryEmbedder | null = null;
+const recent = new Map<string, Float32Array>();
+
+export function registerQueryEmbedder(fn: QueryEmbedder | null): void {
+  embedder = fn;
+}
+
+export function rememberQueryVector(text: string, vec: Float32Array): void {
+  recent.delete(text);
+  recent.set(text, vec);
+  while (recent.size > KEEP) recent.delete(recent.keys().next().value as string);
+}
+
+/** The text's vector: the one retrieval computed for this exact text, else one embedding call; undefined if neither works. */
+export async function queryVectorFor(text: string): Promise<Float32Array | undefined> {
+  const hit = recent.get(text);
+  if (hit) return hit;
+  if (!embedder) return undefined;
+  try {
+    const vec = await embedder(text);
+    rememberQueryVector(text, vec);
+    return vec;
+  } catch {
+    return undefined;
+  }
+}
+
+export function clearQueryVectors(): void {
+  recent.clear();
+}
