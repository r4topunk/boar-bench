@@ -0,0 +1,42 @@
+/// <reference types="node" />
+import { describe, it, expect, beforeAll } from "vitest";
+import { execFileSync } from "node:child_process";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { decompress } from "fzstd";
+import { nodeSqliteDatabase } from "./testing/nodeSqlite";
+import { WikiPack } from "./wikiPack";
+
+
+// Made-up, test-only guides; 4-dim int8 lead vectors stand in for bge-small (question vector [1, 0, 0, 0]).
+const pad = "\n\n## Notes\n\n" + Array.from({ length: 6 }, (_, i) => `Filler line ${i} about nothing in particular.`).join(" ");
+const ARTICLES = [
+  { page_id: 1, title: "Altitude sickness", views: 0, source: "enwikivoyage", text: "# Altitude sickness\n\nAltitude sickness hits climbers. Treatment: descend to a lower altitude." + pad },
+  { page_id: 2, title: "Hilltown", views: 0, source: "enwikivoyage", text: "# Hilltown\n\nHilltown roads are steep; climbers feel the altitude." + pad },
+];
+let pack: WikiPack;
+
+beforeAll(async () => {
+  const dir = mkdtempSync(join(tmpdir(), "boar-leadsim-"));
+  writeFileSync(join(dir, "a.jsonl"), ARTICLES.map((a) => JSON.stringify(a)).join("\n") + "\n");
+  const out = join(dir, "p.sqlite");
+  execFileSync(process.execPath, ["scripts/build-wiki-pack.mjs", "--out", out, "--shards", join(dir, "a.jsonl"), "--no-embed", "--chunk-chars", "300"], { stdio: "pipe" });
+  const db = new DatabaseSync(out);
+  db.exec("CREATE TABLE IF NOT EXISTS lead_vecs (article_id INTEGER PRIMARY KEY, scale REAL NOT NULL, vec BLOB NOT NULL)");
+  const id = (t: string) => (db.prepare("SELECT id FROM articles WHERE title = ?").get(t) as { id: number }).id;
+  db.prepare("INSERT INTO lead_vecs VALUES (?, 1, ?)").run(id("Altitude sickness"), new Uint8Array(new Int8Array([100, 75, 0, 0]).buffer));
+  db.close();
+  pack = await WikiPack.open(nodeSqliteDatabase(out), decompress);
+}, 60000);
+
+describe("lead cosine on pack hits (title PRF input)", () => {
+  it("is attached per hit when searched with a question vector, absent without a vector or a lead", async () => {
+    const hits = await pack.search("climbers altitude", { k: 6, queryVec: new Float32Array([1, 0, 0, 0]) });
+    const alt = hits.find((h) => h.title === "Altitude sickness")!;
+    expect(alt.leadSim).toBeCloseTo(0.8, 2);
+    expect(hits.find((h) => h.title === "Hilltown")?.leadSim).toBeUndefined();
+    expect((await pack.search("climbers altitude", { k: 6 })).every((h) => h.leadSim === undefined)).toBe(true);
+  });
+});
