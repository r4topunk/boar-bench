@@ -516,6 +516,28 @@ function mainTitle(title: string): string {
   return title.replace(/^(Wikipedia|Wikibooks|Wikivoyage|US government|Appropedia|ethereum\.org|Ethereum EIPs\/ERCs|Ethereum specs|Bitcoin BIPs):\s*/, "").split(/:\s+/)[0];
 }
 
+/** Question↔source cosine above which a retrieved source's title words join the lexical match (p99 random lead 0.53). */
+export const TITLE_PRF_MIN_SIMILARITY = 0.6;
+
+/**
+ * Title pseudo-relevance feedback (Sonar, onsubject-gold-drops-diagnosis option B): the question extended with the
+ * main titles of the retrieved sources that are semantically close to it (a format-2 passage's article-lead cosine,
+ * else the chunk's own cosine), lowercased so they never count as the question's proper nouns. Compression and the
+ * topic filter match words; "headache and nausea at 4,000 m" shares none with "Altitude sickness > Treatment",
+ * whose lead is at 0.65 from the question. Retrieval is unchanged.
+ */
+export function titlePrfQuery(query: string, sources: Pick<RetrievedChunk, "title" | "similarity" | "leadSimilarity">[]): string {
+  const have = query.toLowerCase();
+  const extra: string[] = [];
+  for (const c of sources) {
+    const sim = c.leadSimilarity ?? c.similarity;
+    if (sim === undefined || sim < TITLE_PRF_MIN_SIMILARITY) continue;
+    const t = mainTitle(c.title).replace(/\s*\(.*\)$/, "").trim().toLowerCase();
+    if (t && !have.includes(t) && !extra.includes(t)) extra.push(t);
+  }
+  return extra.length ? `${query} ${extra.join(" ")}` : query;
+}
