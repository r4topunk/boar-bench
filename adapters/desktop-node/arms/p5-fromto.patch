@@ -200,8 +200,11 @@ const TRIP_INTENT = /\b(visit|visiting|things to (see|do)|see and do|get (to|the
  * A travel question: the only kind whose capitalized Wikivoyage destination goes first. Narrower than
  * TRAVEL_INTENT, which only orders sources (the guide before the encyclopedia article).
  */
+// Sonar P-5: point-to-point trips ("get from Chiang Mai to Pai"): capitalized origin and destination.
+const FROM_TO_TRIP = /\b(get|go|travel|getting|going) from \p{Lu}[\p{L}.' -]*? to \p{Lu}/u;
+
 export function isTravelQuestion(query: string): boolean {
-  return TRIP_INTENT.test(query) || TRAVEL_PRACTICAL.test(query);
+  return TRIP_INTENT.test(query) || TRAVEL_PRACTICAL.test(query) || FROM_TO_TRIP.test(query);
 }
 
