 /** Cosine (bge-small) of a lead that's about the question even without its words. */
 export const SEMANTIC_KEEP = 0.7;
 
+/**
+ * Lead gate (Sonar card `wikivoyage-lead-gate`): a Wikivoyage keyword hit for a question that isn't about travel
+ * must have a guide lead at least MIN_SEMANTIC_SIMILARITY (0.55) from the question, the floor every other
+ * semantic hit already meets. Travel prose shares words with many questions ("population", "bones", "world cup"),
+ * so guides like Saransk reached the sources of a World Cup question on keyword coverage alone.
+ * Not gated: travel questions (the guide is the source even when its lead is far from the wording), what-to-do and
+ * health questions (they keep their lay sources and the health route's own filter), a Portuguese question's first
+ * pass (its English-names search is gated with the English vector), and guides without a lead vector.
+ */
+export function leadGateApplies(query: string, action: boolean): boolean {
+  return !action && !isTravelQuestion(query) && !TRAVEL_INTENT.test(query) && !isHealthQuestion(query) && !looksPortuguese(query);
+}
+
+export function passesLeadGate(source: PackSource, leadSim: number | undefined): boolean {
+  return source !== "enwikivoyage" || leadSim === undefined || leadSim >= MIN_SEMANTIC_SIMILARITY;
+}
+
 /** Monthly views below which a topic is "long tail": answer from the sources, not the model's memory. */
 export const LONG_TAIL_VIEWS = 5000;
 
